# Required MT5 demo connection settings (never commit .env)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Set true only after validating the intended demo account.
PM5_LIVE_TRADING=false
PM5_DATA_DIR=ProjectMayhem/data
PM5_LOG_DIR=ProjectMayhem/logs
PM5_SYMBOLS=GBPJPY,USDJPY
PM5_H1_BARS=250
PM5_M15_BARS=500
PM5_MAX_SPREAD_POINTS=50
PM5_MAX_QUOTE_AGE_SECONDS=30
PM5_RISK_PERCENT=2.0
PM5_TARGET_R=2.0
PM5_STOP_BUFFER_POINTS=5
PM5_SIGNAL_EXPIRY_MINUTES=60
PM5_SESSION_START_UTC=07:00
PM5_SESSION_END_UTC=17:00
